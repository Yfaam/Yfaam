{% comment %}
  CollectionPage + ItemList structured data: the products on this page of the
  collection, in the order shown, so search and answer engines read the grid
  as a defined set instead of inferring it.

  Rendered on the first page of a collection, where collection.products is the
  same first 50 products the grid shows.

  Accepts: collection
{% endcomment %}

{%- if collection.products.size > 0 -%}
  {%- liquid
    assign collection_url = shop.url | append: collection.url
    assign description = collection.description | strip_html | strip_newlines | truncatewords: 40
  -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      "@id": {{ collection_url | append: '#collection' | json }},
      "url": {{ collection_url | json }},
      "name": {{ collection.title | json }},
      {%- if description != blank %}
      "description": {{ description | json }},
      {%- endif %}
      "inLanguage": {{ request.locale.iso_code | json }},
      "isPartOf": { "@id": {{ shop.url | append: '/#website' | json }} },
      "mainEntity": {
        "@type": "ItemList",
        "numberOfItems": {{ collection.products_count }},
        "itemListElement": [
          {%- for product in collection.products -%}
            {
              "@type": "ListItem",
              "position": {{ forloop.index }},
              "name": {{ product.title | json }},
              "url": {{ shop.url | append: product.url | json }}
            }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ]
      }
    }
  </script>
{%- endif -%}
