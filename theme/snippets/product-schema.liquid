{% comment %}
  Product structured data. ProductGroup + one Offer per size variant, so
  search engines see real price and stock per size instead of only the
  currently-selected one.
{% endcomment %}

{%- comment -%}
  Vendors are spelled three ways in the admin (MAYF Home, Mayf Home, Mayf
  home). Any of them is the house brand, so the schema prints it one way.
{%- endcomment -%}
{%- liquid
  assign rating = product.metafields.reviews.rating.value
  assign rating_count = product.metafields.reviews.rating_count.value | default: 0

  assign brand_name = product.vendor | default: 'MAYF Home'
  assign vendor_check = brand_name | downcase
  if vendor_check contains 'mayf'
    assign brand_name = 'MAYF Home'
  endif

  assign size_option_index = 0
  for option in product.options_with_values
    if option.name == 'Size'
      assign size_option_index = forloop.index
    endif
  endfor
-%}

<script type="application/ld+json">
  {
    "@context": "https://schema.org/",
    "@type": "ProductGroup",
    "name": {{ product.title | json }},
    "description": {{ product.description | strip_html | truncatewords: 60 | json }},
    "url": {{ shop.url | append: product.url | json }},
    "brand": { "@type": "Brand", "name": {{ brand_name | json }} },
    "productGroupID": {{ product.handle | json }},
    "variesBy": ["https://schema.org/size"],
    {%- if product.featured_media %}
    "image": [{{ product.featured_media | image_url: width: 1200 | prepend: 'https:' | json }}],
    {%- endif %}
    {%- if rating and rating_count > 0 %}
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": {{ rating.rating | json }},
      "reviewCount": {{ rating_count | json }},
      "bestRating": {{ rating.scale_max | default: 5 | json }}
    },
    {%- endif %}
    "hasVariant": [
      {%- for variant in product.variants -%}
        {%- liquid
          assign variant_size = variant.title
          if size_option_index == 1
            assign variant_size = variant.option1
          elsif size_option_index == 2
            assign variant_size = variant.option2
          elsif size_option_index == 3
            assign variant_size = variant.option3
          endif
        -%}
        {
          "@type": "Product",
          "name": {{ product.title | append: ' — ' | append: variant_size | json }},
          "sku": {{ variant.sku | json }},
          {%- if size_option_index > 0 %}
          "size": {{ variant_size | json }},
          {%- endif %}
          "offers": {
            "@type": "Offer",
            "url": {{ shop.url | append: variant.url | json }},
            "priceCurrency": {{ cart.currency.iso_code | json }},
            "price": {{ variant.price | divided_by: 100.0 | json }},
            "availability": {% if variant.available %}"https://schema.org/InStock"{% else %}"https://schema.org/OutOfStock"{% endif %},
            "seller": { "@id": {{ shop.url | append: '/#organization' | json }} },
            "shippingDetails": {
              "@type": "OfferShippingDetails",
              "shippingRate": { "@type": "MonetaryAmount", "value": "0", "currency": {{ cart.currency.iso_code | json }} },
              "shippingDestination": { "@type": "DefinedRegion", "addressCountry": "AE" }
            },
            "hasMerchantReturnPolicy": {
              "@type": "MerchantReturnPolicy",
              "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
              "merchantReturnDays": 14,
              "returnMethod": "https://schema.org/ReturnByMail"
            }
          }
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
</script>
