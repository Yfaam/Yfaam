{%- if request.page_type == 'product' -%}
  {%- assign og_title = product.title -%}
  {%- assign og_description = product.description | strip_html | truncatewords: 30 -%}
  {%- assign og_image = product.featured_media -%}
  {%- assign og_type = 'product' -%}
{%- elsif request.page_type == 'collection' -%}
  {%- assign og_title = collection.title -%}
  {%- assign og_description = collection.description | strip_html | truncatewords: 30 -%}
  {%- assign og_image = collection.featured_image -%}
  {%- assign og_type = 'website' -%}
{%- elsif request.page_type == 'article' -%}
  {%- assign og_title = article.title -%}
  {%- assign og_description = page_description -%}
  {%- assign og_image = article.image -%}
  {%- assign og_type = 'article' -%}
{%- else -%}
  {%- assign og_title = page_title -%}
  {%- assign og_description = page_description -%}
  {%- assign og_type = 'website' -%}
{%- endif -%}

<meta property="og:site_name" content="MAYF Home">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ og_description | escape }}">
{%- if og_image -%}
  <meta property="og:image" content="https:{{ og_image | image_url: width: 1200 }}">
  <meta property="og:image:width" content="1200">
  <meta name="twitter:image" content="https:{{ og_image | image_url: width: 1200 }}">
{%- endif -%}
{%- if request.page_type == 'article' -%}
  <meta property="article:published_time" content="{{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' }}">
  <meta property="article:modified_time" content="{{ article.updated_at | default: article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' }}">
{%- endif -%}
{%- if request.page_type == 'product' -%}
  <meta property="product:price:amount" content="{{ product.selected_or_first_available_variant.price | divided_by: 100.0 }}">
  <meta property="product:price:currency" content="{{ cart.currency.iso_code }}">
{%- endif -%}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_description | escape }}">

{% render 'organization-schema' %}

{%- comment -%}
  Structured data for collections, articles and pages. FAQPage is read from
  the FAQ block in the authored content, so there is no second copy to
  maintain. The mattress-toppers collection template has its own FAQ section,
  which already prints FAQPage, and a page must not carry two.
{%- endcomment -%}
{%- case request.page_type -%}
  {%- when 'collection' -%}
    {%- if current_page == 1 -%}
      {% render 'collection-schema', collection: collection %}
      {%- unless template.suffix == 'mattress-toppers' -%}
        {% render 'faq-schema-html', html: collection.description %}
      {%- endunless -%}
    {%- endif -%}
  {%- when 'article' -%}
    {% render 'article-schema', article: article, blog: blog %}
    {% render 'faq-schema-html', html: article.content %}
  {%- when 'page' -%}
    {% render 'faq-schema-html', html: page.content %}
{%- endcase -%}
