{% comment %}
  Spec comparison of the products in the current collection (used on the
  Hotel Collection landing page).

  Everything comes from live product data so it can't go stale:
    Top       — tags: pillow-top / euro-top / tight-top
    Firmness  — custom.firmness_scale ("9/10"), else custom.firmness
    FR        — tag: fire-retardant
    Sizes     — first and last value of the Size option
    From      — lowest variant price
  A cell with no data shows a dash rather than a guess.
{% endcomment %}

<section class="section {% if section.settings.background == 'surface' %}section--surface{% endif %}" id="compare" {{ section.shopify_attributes }}>
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="section-heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="section-subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}

    <div class="compare-table__scroll" tabindex="0" role="region" aria-label="{{ section.settings.heading | escape }}">
      <table class="compare-table">
        <thead>
          <tr>
            <th scope="col">{{ section.settings.col_product }}</th>
            <th scope="col">{{ section.settings.col_top }}</th>
            <th scope="col">{{ section.settings.col_firmness }}</th>
            <th scope="col">{{ section.settings.col_fr }}</th>
            <th scope="col">{{ section.settings.col_sizes }}</th>
            <th scope="col">{{ section.settings.col_price }}</th>
          </tr>
        </thead>
        <tbody>
          {%- for product in collection.products limit: 12 -%}
            {%- liquid
              assign top = '—'
              if product.tags contains 'pillow-top'
                assign top = 'Pillow top'
              elsif product.tags contains 'euro-top'
                assign top = 'Euro top'
              elsif product.tags contains 'tight-top'
                assign top = 'Tight top'
              endif

              assign firmness = '—'
              if product.metafields.custom.firmness_scale != blank
                assign firmness = product.metafields.custom.firmness_scale.value | append: '/10'
              elsif product.metafields.custom.firmness != blank
                assign firmness = product.metafields.custom.firmness.value
              endif

              assign sizes = '—'
              for option in product.options_with_values
                if option.name == 'Size'
                  if option.values.size > 1
                    assign sizes = option.values.first | append: ' – ' | append: option.values.last
                  else
                    assign sizes = option.values.first
                  endif
                endif
              endfor
            -%}
            <tr>
              <th scope="row"><a href="{{ product.url }}">{{ product.title }}</a></th>
              <td>{{ top }}</td>
              <td>{{ firmness }}</td>
              <td>{% if product.tags contains 'fire-retardant' %}{{ section.settings.fr_yes }}{% else %}—{% endif %}</td>
              <td>{{ sizes }}</td>
              <td>{{ product.price_min | money }}</td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>

    {%- if section.settings.note != blank -%}
      <p class="compare-table__note">{{ section.settings.note }}</p>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .compare-table__scroll { overflow-x: auto; margin-top: var(--space-5); -webkit-overflow-scrolling: touch; }
  .compare-table { width: 100%; min-width: 640px; border-collapse: collapse; font-size: 0.9rem; }
  .compare-table th,
  .compare-table td { padding: 12px 14px; text-align: start; border-bottom: 1px solid var(--color-border); vertical-align: top; }
  .compare-table thead th { background: var(--color-text); color: var(--color-bg); font-weight: 600; white-space: nowrap; }
  .compare-table tbody th { font-weight: 600; }
  .compare-table tbody th a { color: inherit; }
  .compare-table tbody tr:nth-child(even) > * { background: var(--color-sand); }
  .compare-table__note { margin-top: var(--space-3); font-size: 0.85rem; color: var(--color-text-muted); }
{% endstylesheet %}

{% schema %}
{
  "name": "Collection comparison",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Compare the range" },
    { "type": "text", "id": "subheading", "label": "Sub-heading" },
    { "type": "text", "id": "col_product", "label": "Column: product", "default": "Mattress" },
    { "type": "text", "id": "col_top", "label": "Column: top", "default": "Top" },
    { "type": "text", "id": "col_firmness", "label": "Column: firmness", "default": "Firmness" },
    { "type": "text", "id": "col_fr", "label": "Column: fire retardant", "default": "Fire retardant" },
    { "type": "text", "id": "col_sizes", "label": "Column: sizes", "default": "Sizes" },
    { "type": "text", "id": "col_price", "label": "Column: price", "default": "From" },
    { "type": "text", "id": "fr_yes", "label": "Fire retardant label", "default": "Yes (FR)" },
    { "type": "text", "id": "note", "label": "Note under the table" },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "default", "label": "White" },
        { "value": "surface", "label": "Warm" }
      ],
      "default": "default"
    }
  ],
  "presets": [{ "name": "Collection comparison" }]
}
{% endschema %}
