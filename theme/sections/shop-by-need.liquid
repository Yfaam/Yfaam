{% comment %}
  Shop by need.

  Shoppers know their problem ("I sleep hot", "we're a couple") before they know
  the technology (latex, pocket springs). Each card turns a need into a place in
  the catalogue. Copy lives in the locale files so Arabic is automatic; only the
  destinations are set here.
{% endcomment %}

{%- liquid
  assign icons = 'sparkle,leaf,shield,heart,moon,lamp,ruler,bed' | split: ','
-%}

<section class="section {% if section.settings.background == 'surface' %}section--surface{% endif %}" {{ section.shopify_attributes }}>
  <div class="page-width">
    <div class="need-heading">
      <p class="need-heading__eyebrow">{{ 'sections.home.need_eyebrow' | t }}</p>
      <h2 class="need-heading__title">{{ 'sections.home.need_heading' | t }}</h2>
      <p class="need-heading__text">{{ 'sections.home.need_text' | t }}</p>
    </div>

    <ul class="need-grid">
      {%- for i in (1..8) -%}
        {%- liquid
          assign link_key = 'link_' | append: i
          assign title_key = 'sections.home.need_' | append: i
          assign target = section.settings[link_key] | default: routes.all_products_collection_url
          assign icon_name = icons[forloop.index0]
        -%}
        <li>
          <a class="need-card" href="{{ target }}">
            <span class="need-card__icon">{% render 'icon', name: icon_name %}</span>
            <span class="need-card__title">{{ title_key | t }}</span>
            <span class="need-card__arrow" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><path d="M5 12H19M19 12L13 6M19 12L13 18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% stylesheet %}
  .need-heading { text-align: center; max-width: 640px; margin: 0 auto var(--space-6, 40px); }
  .need-heading__eyebrow { font-size: 12px; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: var(--color-accent); margin: 0 0 10px; }
  .need-heading__title { font-family: var(--font-heading); font-size: clamp(28px, 3.6vw, 42px); line-height: 1.15; margin: 0 0 12px; }
  .need-heading__text { margin: 0; color: var(--color-text-muted); }

  .need-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }

  .need-card {
    display: flex;
    align-items: center;
    gap: 14px;
    height: 100%;
    padding: 20px 18px;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    background: var(--color-bg);
    color: inherit;
    text-decoration: none;
    transition: box-shadow 0.25s ease, border-color 0.25s ease;
  }

  .need-card:hover { box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08); border-color: var(--color-accent); }
  .need-card__icon { flex: none; width: 28px; height: 28px; color: var(--color-accent); display: flex; }
  .need-card__icon svg { width: 100%; height: 100%; }
  .need-card__title { flex: 1; font-weight: 600; line-height: 1.3; }
  .need-card__arrow { flex: none; color: var(--color-accent); display: flex; }
  [dir="rtl"] .need-card__arrow svg { transform: scaleX(-1); }

  @media (max-width: 989px) { .need-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 599px) {
    .need-grid { gap: 10px; }
    .need-card { flex-direction: column; align-items: flex-start; gap: 10px; padding: 16px 14px; }
    .need-card__arrow { display: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Shop by need",
  "settings": [
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "default", "label": "White" },
        { "value": "surface", "label": "Warm" }
      ],
      "default": "surface"
    },
    { "type": "header", "content": "Where each card goes (copy is in Language editor)" },
    { "type": "url", "id": "link_1", "label": "1. Bring Hotel Sleep Home" },
    { "type": "url", "id": "link_2", "label": "2. I Sleep Hot" },
    { "type": "url", "id": "link_3", "label": "3. Back & Body Support" },
    { "type": "url", "id": "link_4", "label": "4. Couples & Motion Isolation" },
    { "type": "url", "id": "link_5", "label": "5. Kids & Growing Sleepers" },
    { "type": "url", "id": "link_6", "label": "6. New Home Essentials" },
    { "type": "url", "id": "link_7", "label": "7. Large Windows & Curtains" },
    { "type": "url", "id": "link_8", "label": "8. Upgrade My Entire Bedroom" }
  ],
  "presets": [{ "name": "Shop by need" }]
}
{% endschema %}
