{% comment %}
  Why MAYF Home. A short brand argument that replaces generic ecommerce badges
  (Premium Quality / Sustainable Choice). Copy is in the locale files.
{% endcomment %}

{%- liquid
  assign icons = 'sparkle,moon,tag,headset,truck' | split: ','
-%}

<section class="section {% if section.settings.background == 'surface' %}section--surface{% endif %}" {{ section.shopify_attributes }}>
  <div class="page-width">
    <div class="why-heading">
      <p class="why-heading__eyebrow">{{ 'sections.home.why_eyebrow' | t }}</p>
      <h2 class="why-heading__title">{{ 'sections.home.why_heading' | t }}</h2>
    </div>

    <ul class="why-grid">
      {%- for i in (1..5) -%}
        {%- liquid
          assign title_key = 'sections.home.why_' | append: i | append: '_title'
          assign text_key = 'sections.home.why_' | append: i | append: '_text'
          assign icon_name = icons[forloop.index0]
        -%}
        <li class="why-item">
          <span class="why-item__icon">{% render 'icon', name: icon_name %}</span>
          <h3 class="why-item__title">{{ title_key | t }}</h3>
          <p class="why-item__text">{{ text_key | t }}</p>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% stylesheet %}
  .why-heading { text-align: center; max-width: 640px; margin: 0 auto var(--space-6, 40px); }
  .why-heading__eyebrow { font-size: 12px; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: var(--color-accent); margin: 0 0 10px; }
  .why-heading__title { font-family: var(--font-heading); font-size: clamp(28px, 3.6vw, 42px); line-height: 1.15; margin: 0; }

  .why-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(5, 1fr); gap: 28px 24px; }
  .why-item { text-align: center; }
  .why-item__icon { display: inline-flex; width: 30px; height: 30px; color: var(--color-accent); margin-bottom: 12px; }
  .why-item__icon svg { width: 100%; height: 100%; }
  .why-item__title { margin: 0 0 6px; font-size: 1rem; font-weight: 700; }
  .why-item__text { margin: 0; font-size: 0.86rem; line-height: 1.55; color: var(--color-text-muted); }

  @media (max-width: 989px) { .why-grid { grid-template-columns: repeat(2, 1fr); } .why-item:last-child { grid-column: 1 / -1; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Why MAYF Home",
  "settings": [
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "default", "label": "White" },
        { "value": "surface", "label": "Warm" }
      ],
      "default": "surface"
    }
  ],
  "presets": [{ "name": "Why MAYF Home" }]
}
{% endschema %}
