{% comment %}
  WhatsApp call-to-action card. Copy comes from the locale files
  (sections.home.visit_*) so it is translated for Arabic automatically.
  Used on the Book a Free Visit page, above the booking form.
{% endcomment %}

{%- liquid
  assign wa_label = 'sections.home.visit_whatsapp_button' | t
  assign wa_message = 'sections.home.visit_whatsapp_message' | t
-%}

{%- if settings.whatsapp_number != blank -%}
  <section class="section--tight" {{ section.shopify_attributes }}>
    <div class="page-width">
      <div class="wa-cta">
        <div class="wa-cta__copy">
          <h2 class="wa-cta__title">{{ 'sections.home.visit_whatsapp_title' | t }}</h2>
          <p class="wa-cta__text">{{ 'sections.home.visit_whatsapp_text' | t }}</p>
        </div>
        {% render 'whatsapp-link', label: wa_label, message: wa_message, class: 'btn--lg' %}
      </div>
      <p class="wa-cta__or">{{ 'sections.home.visit_or_form' | t }}</p>
    </div>
  </section>
{%- endif -%}

{% stylesheet %}
  .wa-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 18px 32px;
    padding: clamp(20px, 3vw, 32px);
    border-radius: var(--radius);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
  }
  .wa-cta__copy { flex: 1 1 320px; }
  .wa-cta__title { margin: 0 0 6px; font-family: var(--font-heading); font-size: clamp(1.2rem, 2.2vw, 1.6rem); line-height: 1.2; }
  .wa-cta__text { margin: 0; color: var(--color-text-muted); max-width: 58ch; }
  .wa-cta__or { margin: 22px 0 0; text-align: center; font-size: 0.85rem; color: var(--color-text-muted); }
  @media (max-width: 599px) { .wa-cta .btn { width: 100%; justify-content: center; } }
{% endstylesheet %}

{% schema %}
{
  "name": "WhatsApp call-to-action",
  "presets": [{ "name": "WhatsApp call-to-action" }]
}
{% endschema %}
