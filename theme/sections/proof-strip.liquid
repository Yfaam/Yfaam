{% comment %}
  Proof strip, directly under the hero.

  Five specific promises instead of generic badges. Copy comes from the locale
  files (sections.home.proof_*) so it is translated for Arabic automatically.
  Each item can optionally link somewhere (returns policy, shipping policy...).
{% endcomment %}

{%- liquid
  assign keys = 'trial,warranty,delivery,pay,whatsapp' | split: ','
  assign icons = 'clock,shield,truck,installment,headset' | split: ','
-%}

<section class="proof-strip" {{ section.shopify_attributes }}>
  <div class="page-width">
    <ul class="proof-strip__list">
      {%- for key in keys -%}
        {%- liquid
          assign title_key = 'sections.home.proof_' | append: key | append: '_title'
          assign text_key = 'sections.home.proof_' | append: key | append: '_text'
          assign link_key = 'link_' | append: forloop.index
          assign item_link = section.settings[link_key]
          assign icon_name = icons[forloop.index0]
        -%}
        <li class="proof-strip__item">
          {%- if item_link != blank -%}<a class="proof-strip__link" href="{{ item_link }}">{%- endif -%}
            <span class="proof-strip__icon">{% render 'icon', name: icon_name %}</span>
            <span class="proof-strip__copy">
              <span class="proof-strip__title">{{ title_key | t }}</span>
              <span class="proof-strip__text">{{ text_key | t }}</span>
            </span>
          {%- if item_link != blank -%}</a>{%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% stylesheet %}
  .proof-strip {
    border-block: 1px solid var(--color-border);
    background: var(--color-bg);
  }

  .proof-strip__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
  }

  .proof-strip__item { padding: 18px 14px; display: flex; align-items: center; gap: 12px; }
  .proof-strip__item + .proof-strip__item { border-inline-start: 1px solid var(--color-border); }
  .proof-strip__link { display: flex; align-items: center; gap: 12px; width: 100%; color: inherit; text-decoration: none; }

  .proof-strip__icon { flex: none; width: 26px; height: 26px; color: var(--color-accent); display: flex; }
  .proof-strip__icon svg { width: 100%; height: 100%; }
  .proof-strip__copy { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .proof-strip__title { font-size: 0.82rem; font-weight: 700; line-height: 1.25; }
  .proof-strip__text { font-size: 0.74rem; color: var(--color-text-muted); line-height: 1.3; }

  @media (max-width: 989px) {
    .proof-strip__list { grid-template-columns: repeat(2, 1fr); }
    .proof-strip__item:nth-child(odd) { border-inline-start: 0; }
    .proof-strip__item:nth-child(n + 3) { border-top: 1px solid var(--color-border); }
    .proof-strip__item:last-child:nth-child(odd) { grid-column: 1 / -1; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Proof strip",
  "settings": [
    { "type": "header", "content": "Optional links" },
    { "type": "url", "id": "link_1", "label": "100-night trial link" },
    { "type": "url", "id": "link_2", "label": "Warranty link" },
    { "type": "url", "id": "link_3", "label": "Delivery link" },
    { "type": "url", "id": "link_4", "label": "Tabby & Tamara link" },
    { "type": "url", "id": "link_5", "label": "WhatsApp link" }
  ],
  "presets": [{ "name": "Proof strip" }]
}
{% endschema %}
