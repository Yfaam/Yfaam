{% comment %}
  Mattress finder banner.

  Text falls back to the locale files (sections.home.finder_*) when the
  settings are left blank, so the banner is translated for Arabic automatically.
{% endcomment %}

{%- liquid
  assign eyebrow = section.settings.eyebrow
  if eyebrow == blank
    assign eyebrow = 'sections.home.finder_eyebrow' | t
  endif

  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'sections.home.finder_title' | t
  endif

  assign text = section.settings.text
  if text == blank
    assign text = 'sections.home.finder_text' | t
  endif

  assign button_label = section.settings.button_label
  if button_label == blank
    assign button_label = 'sections.home.finder_button' | t
  endif
-%}

<section class="section" {{ section.shopify_attributes }}>
  <div class="page-width">
    <div class="quiz-banner">

      <div class="quiz-banner__body">
        <p class="quiz-banner__eyebrow">{{ eyebrow }}</p>
        <h2 class="quiz-banner__title">{{ heading }}</h2>
        <p class="quiz-banner__text">{{ text }}</p>
        <a href="{{ section.settings.button_link | default: settings.quiz_url }}" class="btn btn--primary">
          {{ button_label }}
        </a>
      </div>

      <div class="quiz-banner__media">
        {%- if section.settings.image != blank -%}
          <img
            src="{{ section.settings.image | image_url: width: 1600 }}"
            alt="{{ section.settings.image.alt | escape }}"
            loading="lazy">
        {%- endif -%}
      </div>

    </div>
  </div>
</section>

{% stylesheet %}
  .quiz-banner {
    display: flex;
    min-height: 220px;
    background: var(--color-surface);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .quiz-banner__body {
    flex: 0 0 55%;
    padding: 24px clamp(20px, 3vw, 44px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    gap: 8px;
    background: var(--color-surface);
    position: relative;
    z-index: 1;
  }

  .quiz-banner__media {
    flex: 1;
    overflow: hidden;
  }

  .quiz-banner__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 42%;
  }

  .quiz-banner__eyebrow {
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin: 0;
  }

  .quiz-banner__title {
    font-size: clamp(1.25rem, 2.2vw, 1.75rem);
    font-weight: 700;
    line-height: 1.2;
    color: var(--color-text);
    margin: 0;
  }

  .quiz-banner__text {
    font-size: 0.92rem;
    color: var(--color-text-muted);
    margin: 0 0 6px;
    max-width: 48ch;
  }

  @media (max-width: 749px) {
    .quiz-banner {
      flex-direction: column;
      min-height: 0;
    }

    .quiz-banner__body {
      flex: none;
      padding: 24px 20px;
    }

    .quiz-banner__media {
      flex: none;
      height: 180px;
    }

    .quiz-banner__media img {
      height: 180px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Quiz banner",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "info": "Leave blank to use the translated default (Language editor)." },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Leave blank to use the translated default." },
    { "type": "text", "id": "text", "label": "Text", "info": "Leave blank to use the translated default." },
    { "type": "text", "id": "button_label", "label": "Button label", "info": "Leave blank to use the translated default." },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "Falls back to the quiz URL in theme settings." }
  ],
  "presets": [{ "name": "Quiz banner" }]
}
{% endschema %}
