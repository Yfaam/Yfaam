{% comment %}
  Curtain lead-generation.

  Curtains are a consultation purchase, not a quick-add one. The three routes
  match three levels of readiness: estimate it yourself, book a visit, or ask
  a person. Copy comes from the locale files so Arabic is automatic.
{% endcomment %}

{%- liquid
  assign wa_label = 'sections.home.curtain_whatsapp' | t
  assign wa_message = 'sections.home.curtain_whatsapp_message' | t
-%}

<section class="section" {{ section.shopify_attributes }}>
  <div class="page-width">
    <div class="curtain-cta">
      <div class="curtain-cta__body">
        <p class="curtain-cta__eyebrow">{{ 'sections.home.curtain_eyebrow' | t }}</p>
        <h2 class="curtain-cta__title">{{ 'sections.home.curtain_title' | t }}</h2>
        <p class="curtain-cta__text">{{ 'sections.home.curtain_text' | t }}</p>

        <div class="curtain-cta__buttons">
          {%- if section.settings.estimator_link != blank -%}
            <a href="{{ section.settings.estimator_link }}" class="btn btn--primary">{{ 'sections.home.curtain_estimate' | t }}</a>
          {%- endif -%}
          {%- if section.settings.visit_link != blank -%}
            <a href="{{ section.settings.visit_link }}" class="btn btn--secondary">{{ 'sections.home.curtain_visit' | t }}</a>
          {%- endif -%}
          {% render 'whatsapp-link', label: wa_label, message: wa_message %}
        </div>
      </div>

      {%- if section.settings.image != blank -%}
        <div class="curtain-cta__media">
          <img
            src="{{ section.settings.image | image_url: width: 1200 }}"
            alt="{{ section.settings.image.alt | escape }}"
            width="{{ section.settings.image.width }}"
            height="{{ section.settings.image.height }}"
            loading="lazy">
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .curtain-cta {
    display: flex;
    background: var(--color-surface);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .curtain-cta__body {
    flex: 1 1 52%;
    padding: clamp(24px, 4vw, 56px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 12px;
  }

  .curtain-cta__media { flex: 1 1 48%; min-height: 280px; }
  .curtain-cta__media img { display: block; width: 100%; height: 100%; object-fit: cover; }

  .curtain-cta__eyebrow { margin: 0; font-size: 12px; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: var(--color-accent); }
  .curtain-cta__title { margin: 0; font-family: var(--font-heading); font-size: clamp(26px, 3.2vw, 38px); line-height: 1.15; }
  .curtain-cta__text { margin: 0; max-width: 52ch; color: var(--color-text-muted); }
  .curtain-cta__buttons { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 8px; }

  @media (max-width: 749px) {
    .curtain-cta { flex-direction: column-reverse; }
    .curtain-cta__media { min-height: 200px; flex: none; }
    .curtain-cta__buttons .btn { width: 100%; justify-content: center; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Curtain lead-gen",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "url", "id": "estimator_link", "label": "Online price estimator link" },
    { "type": "url", "id": "visit_link", "label": "Book a free visit link" }
  ],
  "presets": [{ "name": "Curtain lead-gen" }]
}
{% endschema %}
